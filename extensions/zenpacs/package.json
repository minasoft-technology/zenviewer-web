{
  "name": "@zenpacs/extension-zenpacs",
  "version": "1.0.0",
  "description": "ZenPACS integration for web viewer — status buttons, voice recording, anamnesis panel",
  "author": "Minasoft Technology",
  "license": "PROPRIETARY",
  "main": "dist/zenpacs-extension.umd.js",
  "module": "src/index.ts",
  "engines": {
    "node": ">=18",
    "yarn": ">=1.18.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ohif-extension"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "start": "yarn run dev"
  },
  "peerDependencies": {
    "@ohif/core": "3.13.0-beta.57",
    "@ohif/ui": "3.13.0-beta.57",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@babel/runtime": "7.28.2"
  }
}
